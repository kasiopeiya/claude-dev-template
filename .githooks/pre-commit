#!/bin/sh
# ci-format（prettier --check .）が push 後に落ちるのを防ぐため、
# コミット前にステージ済みファイルだけを prettier で整形して再ステージする。
# 併せて、ADR を変更した場合は adr-index.md を frontmatter から再生成し再ステージする（Issue #50）。

# ADR 本体が変更されていれば一覧表を再生成する（生成物 adr-index.md 自体の変更は除外）。
staged_adr=$(git diff --cached --name-only --diff-filter=ACMRD -- 'docs/adr/[0-9]*.md')

if [ -n "$staged_adr" ]; then
  npm run --silent gen:adr-index || exit 1
  git add docs/adr/adr-index.md
fi

staged_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.json' '*.md' '*.html')

if [ -z "$staged_files" ]; then
  exit 0
fi

# 未ステージの変更も持つファイル（部分ステージ）は整形対象から除く。
# `git add <パス>` はパス全体を作業ツリーの内容で置き換えるため、再ステージすると
# ステージしていない変更まで commit に混入する（Issue #350）。
unstaged_files=$(git diff --name-only)

format_files=""
skipped_files=""
while IFS= read -r file; do
  [ -n "$file" ] || continue
  if printf '%s\n' "$unstaged_files" | grep -qxF -- "$file"; then
    skipped_files="${skipped_files}${file}
"
  else
    format_files="${format_files}${file}
"
  fi
done <<EOF
$staged_files
EOF

if [ -n "$skipped_files" ]; then
  echo "部分ステージのため prettier の整形をスキップしました（未ステージの変更を混ぜないため）:"
  printf '%s' "$skipped_files" | sed 's/^/  - /'
fi

if [ -z "$format_files" ]; then
  exit 0
fi

printf '%s' "$format_files" | xargs npx prettier --write

printf '%s' "$format_files" | xargs git add
