        </mxCell>
        <mxCell id="1k-QNZXVAfL3gQiTnbz7-6" parent="1k-QNZXVAfL3gQiTnbz7-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#000000);fontSize=22;" value="&lt;ul&gt;&lt;li&gt;HITL: Human On The Loop&lt;br&gt;人間が逐一介入し、チェックする&lt;/li&gt;&lt;li&gt;バイブコーディング&lt;br&gt;レビューはせず、ノールックでマージする&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;HOTL: Human On The Loop&lt;br&gt;人間は仕組みを作る側に周り、必要に応じて介入する&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="232" width="1060" x="26" y="174" as="geometry" />
        </mxCell>
        <mxCell id="DWTLqvYRr2vj2q5eeU8G-0" parent="1k-QNZXVAfL3gQiTnbz7-1" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;left=0;fillColor=none;rotation=90;flipH=0;legacyAnchorPoints=0;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="1170.87" width="539.87" x="456.51" y="174.49" as="geometry" />
        </mxCell>
        <mxCell id="DWTLqvYRr2vj2q5eeU8G-1" parent="1k-QNZXVAfL3gQiTnbz7-1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#CCCCCC;gradientColor=none;strokeColor=#000000;strokeWidth=5;" value="&lt;br&gt;&amp;nbsp; &lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;HOTL&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;&lt;span&gt;&lt;span style=&quot;color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171));&quot;&gt;Human On The Loop&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;品質担保を仕組み化&lt;br&gt;可能な限りAIに判断を委譲&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;" vertex="1">
