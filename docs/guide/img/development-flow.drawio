        </mxCell>
        <mxCell id="ld2UybNnEVV5ZByfv2aw-4" parent="ld2UybNnEVV5ZByfv2aw-3" style="text;whiteSpace=wrap;html=1;fontSize=75;" value="レビューボトルネック問題の対策" vertex="1">
          <mxGeometry height="100" width="1371.8949969116738" x="11.105003088326129" as="geometry" />
        </mxCell>
        <mxCell id="ld2UybNnEVV5ZByfv2aw-5" parent="ld2UybNnEVV5ZByfv2aw-3" style="whiteSpace=wrap;html=1;fillColor=#000000;" value="" vertex="1">
          <mxGeometry height="90" width="5.979617047560223" y="5" as="geometry" />
        </mxCell>
        <mxCell id="ld2UybNnEVV5ZByfv2aw-6" parent="ld2UybNnEVV5ZByfv2aw-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#000000);fontSize=22;" value="&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;1.&amp;nbsp; 人間の認知的な負荷を減らす&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;br style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;・レビュー前にあらゆるチェックを済ませる&lt;br&gt;&lt;/span&gt;→静的解析・テスト・コードメトリクス等の拡充とCI組み込み&lt;br style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;・AIに初めから人間のイメージ通りの成果物を出させる&lt;/span&gt;&lt;br style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;→AIによる１次レビュー、サンプルの提示、人間の考え方をドキュメント化&lt;br&gt;&lt;br&gt;・PRのサイズを小さくする&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;→トランクベースアプローチの導入、レビュールールのドキュメント化&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;2. そもそもレビューするべき対象を限定する&lt;/font&gt;&lt;/span&gt;&lt;br style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;・人間のレビューが必要な変更とそうではないものを分類する&lt;br&gt;→人間レビューの判断基準をドキュメント化&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="536" width="1060" x="119" y="276" as="geometry" />
        </mxCell>
        <mxCell id="ZjPIUwiOKVrp3Pq2ZSD4-0" parent="ld2UybNnEVV5ZByfv2aw-1" style="text;whiteSpace=wrap;html=1;fontSize=35;fillColor=none;" value="これら対策で人間負担を減らし、それを仕組みとして組み込むことができれば、高度に自動化され、品質と開発スピードを両立する開発フローを作れると考えた" vertex="1">
          <mxGeometry height="127" width="1278" x="171" y="896" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
