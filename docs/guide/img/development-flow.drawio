        <mxCell id="1k-QNZXVAfL3gQiTnbz7-4" parent="1k-QNZXVAfL3gQiTnbz7-3" style="text;whiteSpace=wrap;html=1;fontSize=75;" value="目指すべき方向性：HOTL" vertex="1">
          <mxGeometry height="100" width="1371.8949969116738" x="11.105003088326129" as="geometry" />
        </mxCell>
        <mxCell id="1k-QNZXVAfL3gQiTnbz7-5" parent="1k-QNZXVAfL3gQiTnbz7-3" style="whiteSpace=wrap;html=1;fillColor=#000000;" value="" vertex="1">
