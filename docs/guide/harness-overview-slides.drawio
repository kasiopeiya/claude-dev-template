        </mxCell>
        <mxCell id="AL-YYhV-VxJ1iFnzJHqx-1" parent="BL01StOJjvSbYqQzYMc2-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;spacingLeft=14;fontColor=light-dark(#000000,#000000);fontSize=30;" value="&lt;div&gt;&lt;span&gt;&lt;b&gt;これら対策でHOTLを実現し、&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;品質と開発スピードを両立&lt;br&gt;真に生産的なAI駆動開発を実現&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="869" x="336" y="983" as="geometry" />
        </mxCell>
        <mxCell id="mVm5g3d-zvHR4soUjLgo-0" parent="BL01StOJjvSbYqQzYMc2-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#000000);fontSize=22;" value="&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;1. AIに正解を先に示す&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;ポリシー駆動開発で正解を定義しAIに示す&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;→イメージ通りの成果物を出力&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;→レビューで指摘することが少なくなる&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;→人間の負担軽減&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;2. PRのサイズを小さくする&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;短命ブランチの導入&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;→空き時間に&lt;/span&gt;&lt;span style=&quot;font-size: 30px; background-color: transparent;&quot;&gt;気軽に精度&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 30px;&quot;&gt;良く&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 30px;&quot;&gt;レビューできる&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;3. 重要な変更だけ人間レビューする&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;人間レビュー判定基準を定義&lt;br&gt;→重要な変更のレビューに集中できる&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="707" width="974" x="181" y="247" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
