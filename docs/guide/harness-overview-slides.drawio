  <diagram name="deletion-advocate-agent" id="efxmxlBoetddj98Wx8Ri">
    <mxGraphModel dx="1758" dy="1388" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" background="light-dark(#F5F5F5,#121212)" math="0" shadow="0">
      <root>
        <mxCell id="QDaxBL2OE9wjjR2mA8Qn-0" />
        <mxCell id="QDaxBL2OE9wjjR2mA8Qn-1" parent="QDaxBL2OE9wjjR2mA8Qn-0" />
        <mxCell id="dAa1-2" parent="QDaxBL2OE9wjjR2mA8Qn-1" style="text;whiteSpace=wrap;html=1;fontSize=40;fillColor=#D4D2CD;" value="「それ要らなくない？」と聞くだけのサブエージェント" vertex="1">
          <mxGeometry height="64" width="1383" x="37" y="124" as="geometry" />
        </mxCell>
        <mxCell id="dAa1-3" connectable="0" parent="QDaxBL2OE9wjjR2mA8Qn-1" style="group" value="" vertex="1">
          <mxGeometry height="100" width="1383" x="37" y="13" as="geometry" />
        </mxCell>
        <mxCell id="dAa1-4" parent="dAa1-3" style="text;whiteSpace=wrap;html=1;fontSize=75;" value="AIの出力文章量を削減する仕組み" vertex="1">
          <mxGeometry height="100" width="1371.8949969116738" x="11.105003088326129" as="geometry" />
        </mxCell>
        <mxCell id="dAa1-5" parent="dAa1-3" style="whiteSpace=wrap;html=1;fillColor=#000000;" value="" vertex="1">
          <mxGeometry height="90" width="5.979617047560223" y="5" as="geometry" />
        </mxCell>
        <mxCell id="dAa1-6" parent="QDaxBL2OE9wjjR2mA8Qn-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#000000);fontSize=30;" value="&lt;span style=&quot;font-size: 30px;&quot;&gt;AIは網羅的で大量の文章を書こうとする。「要らない行は消す」と手順に書いても効かない&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;　→ 書いた本人が評価すると、ほぼ常に「これは要る」と結論するため&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;対策：書き手の事情を知らない「切り離された読者」を別エージェントにする&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="1480" x="61" y="215" as="geometry" />
        </mxCell>
        <mxCell id="dAa1-8" parent="QDaxBL2OE9wjjR2mA8Qn-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=3;align=center;verticalAlign=middle;spacing=12;fillColor=none;" value="&lt;font style=&quot;font-size: 32px;&quot;&gt;書き手のAI&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;（メインセッション）&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="380" x="60" y="490" as="geometry" />
        </mxCell>
        <mxCell id="dAa1-9" parent="QDaxBL2OE9wjjR2mA8Qn-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=3;align=center;verticalAlign=middle;spacing=12;fillColor=none;" value="&lt;font style=&quot;font-size: 32px;&quot;&gt;サブエージェント&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;（deletion-advocate-agent）&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;見るのは一点&lt;br&gt;&lt;b&gt;消したら読者の行動が変わるか？&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="440" x="1120" y="490" as="geometry" />
        </mxCell>
        <mxCell id="dAa1-10" parent="QDaxBL2OE9wjjR2mA8Qn-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=middle;spacing=10;spacingLeft=16;fontColor=light-dark(#000000,#000000);" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;渡すのは3つだけ&lt;/b&gt;&lt;br&gt;対象読者と用事の一文／節の原文／対象行の印&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="540" x="520" y="510" as="geometry" />
        </mxCell>
        <mxCell id="dAa1-11" parent="QDaxBL2OE9wjjR2mA8Qn-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=middle;spacing=10;spacingLeft=16;fontColor=light-dark(#000000,#000000);dashed=1;dashPattern=8 8;strokeColor=#999999;fontColor=#666666;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;渡さない&lt;/b&gt;&lt;br&gt;経緯・誰が書いたか・「これで良い？」の期待&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="540" x="520" y="660" as="geometry" />
        </mxCell>
        <mxCell id="dAa1-12" parent="QDaxBL2OE9wjjR2mA8Qn-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=middle;spacing=10;spacingLeft=16;fontColor=light-dark(#000000,#000000);" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;返すのは削除候補だけ&lt;/b&gt;（根拠つき）&lt;br&gt;書き直し案は出さない&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="540" x="520" y="820" as="geometry" />
        </mxCell>
        <mxCell id="dAa1-13" edge="1" parent="QDaxBL2OE9wjjR2mA8Qn-1" source="dAa1-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="dAa1-10" value="">
