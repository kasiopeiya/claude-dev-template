        </mxCell>
        <mxCell id="Y1b38c15CBYuXeu-F6Vt-0" parent="v-onH5aQx65fxSii9BpJ-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#000000);fontSize=40;" value="&lt;div&gt;&lt;span&gt;1. AIに正解を先に示す&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;ポリシー駆動開発で正解を定義しAIに示す&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;→イメージ通りの成果物を出力&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;→レビューで指摘することが少なくなる&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;→人間の負担軽減&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;2. PRのサイズを小さくする&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(255, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;b&gt;短命ブランチの導入&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(255, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;b&gt;→空き時間に&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: rgb(255, 0, 0);&quot;&gt;気軽に精度良く&lt;/b&gt;&lt;b style=&quot;color: light-dark(rgb(255, 0, 0), rgb(0, 0, 0)); background-color: transparent;&quot;&gt;レビューできる&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;3. 重要な変更だけ人間レビューする&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="707" width="974" x="196" y="265" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
