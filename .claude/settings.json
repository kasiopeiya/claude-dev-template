{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify-worktree-behind-default-branch.mjs\"",
            "statusMessage": "デフォルトブランチとの差を確認中...",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/policy-loader.mjs\"",
            "statusMessage": "適用ポリシー確認中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-forbidden-commands.mjs\"",
            "statusMessage": "禁止コマンドを確認中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/wake-on-ci-failure.mjs\"",
            "asyncRewake": true,
            "timeout": 2700
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh issue create *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/label-ai-filed-issue.mjs\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/turn-end-gate.mjs\"",
            "statusMessage": "ターン末ゲートを実行中..."
          }
        ]
      }
    ]
  }
}
