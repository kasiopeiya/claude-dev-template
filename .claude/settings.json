{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/policy-loader.mjs\"",
            "statusMessage": "適用ポリシー確認中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-branch-create.mjs\"",
            "statusMessage": "gitブランチ作成操作を確認中..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-empty-gh-body-overwrite.mjs\"",
            "statusMessage": "本文を消すgh操作を確認中..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-unlabeled-gh-issue-create.mjs\"",
            "statusMessage": "Issueのラベル指定を確認中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-oversized-claude-md.mjs\"",
            "statusMessage": "CLAUDE.md の文字数を確認中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/static-check-reminder.mjs\"",
            "statusMessage": "静的ゲート要否を確認中..."
          }
        ]
      }
    ]
  }
}
