{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:static": "npm run lint && npm run knip && (cd app/backend && npm run typecheck) && (cd infra && npm run typecheck)",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:requirements": "node scripts/check-requirements.mjs",
    "check:claude-md": "node scripts/check-claude-md-size.mjs",
    "check:audit": "node scripts/audit-dependencies.mjs",
    "test:hooks": "node --test .claude/hooks/policyMatcher.test.mjs .claude/hooks/policy-loader.test.mjs",
    "gen:adr-index": "node scripts/generate-adr-index.mjs",
    "knip": "knip",
    "knip:fix": "knip --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^17.7.0",
    "knip": "^6.26.0",
    "prettier": "^3.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
